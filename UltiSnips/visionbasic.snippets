# Vision BASIC snippets.
# Generated from the shared snippet definitions used by the VS Code
# extension; regenerate rather than editing by hand.

snippet asm "Inline assembler statement" b
${1:10} [${2:LDA #0}: ${3:STA $D020}] ; ${4:comment}
endsnippet

snippet assem "ASSEM ... BASIC machine language section" b
${1:10} ASSEM
${2:20} START *= ${3:49152}
${4:30} [${5:LDA #0}: ${6:STA $D020}: RTS] ; ${7:comment}
${8:40} BASIC
endsnippet

snippet bitmap "Enable bitmap mode and clear the screen" b
${1:10} BITMAP 1, ${2:0}, 0, 0, 0, 0, 0, 0, 0, 1
${3:20} BMPCLR 1, 1
endsnippet

snippet box "Draw a rectangle with HLINE/VLINE" b
${1:10} HLINE ${2:X}, ${3:Y}, ${4:W}, ${5:1}
${6:20} HLINE ${2:X}, ${3:Y}+${7:H}, ${4:W}, ${5:1}
${8:30} VLINE ${2:X}, ${3:Y}, ${7:H}, ${5:1}
${9:40} VLINE ${2:X}+${4:W}, ${3:Y}, ${7:H}, ${5:1}
endsnippet

snippet collision "Latch the collision registers and test specific sprites" b
${1:10} COLLISION ${2:0}
${3:20} IF DETECT ${4:0}, ${5:1} THEN ${6:GOSUB 2000}
endsnippet

snippet comp "Compile the program in memory and save the result" b
COMP "${1:MYPROG}", ${2:8}
endsnippet

snippet data "DATA block with READ loop" b
${1:10} DATA ${2:1, 2, 3, 4, 5}
${3:20} FOR ${4:I} = 1 TO ${5:5}
${6:30}   READ ${7:V}
${8:40}   ${9:REM process V}
${10:50} NEXT ${4:I}
endsnippet

snippet def "Declare variable types (integer is the default)" b
${1:10} DEF ${2:INTEGER} ${3:X}, ${4:Y}
endsnippet

snippet desc "Attach a name to a line so it can be called like a subroutine" b
${1:10} DESC ${2:1000}, ${3:DRAWSCREEN}
endsnippet

snippet disk "Send a command channel string to a drive" b
${1:10} DISK "${2:S0:OLDFILE}", ${3:8}
endsnippet

snippet do "Run a line a fixed number of times" b
${1:10} DO ${2:1000}, ${3:10}
endsnippet

snippet for "FOR-TO-NEXT loop (integer variables only)" b
${1:10} FOR ${2:I} = ${3:0} TO ${4:9}
${5:20}   REM loop body
${6:30} NEXT ${2:I}
endsnippet

snippet forstep "FOR-TO-STEP-NEXT loop (integer variables only)" b
${1:10} FOR ${2:I} = ${3:0} TO ${4:9} STEP ${5:2}
${6:20}   REM loop body
${7:30} NEXT ${2:I}
endsnippet

snippet if "IF-THEN with ELSE" b
${1:10} IF ${2:A} = ${3:0} THEN ${4:GOTO 100}
${5:20} ELSE ${6:GOTO 200}
endsnippet

snippet interrupt "Raster interrupt skeleton (always HALTINT before exiting)" b
${1:10} INTERRUPT ${2:100}, ${3:1000}

${3:1000} STARTINT
${4:1010}   ${5:REM interrupt body}
${6:1020} INTEND ${7:1}

${8:9000} HALTINT
endsnippet

snippet joy "Read joystick with direction and button checks" b
${1:10} ${2:J} = JOY(${3:2})
${4:20} IF ${2:J} AND 1 THEN ${5:REM up}
${6:30} IF ${2:J} AND 2 THEN ${7:REM down}
${8:40} IF ${2:J} AND 4 THEN ${9:REM left}
${10:50} IF ${2:J} AND 8 THEN ${11:REM right}
${12:60} IF BUTTON ${3:2} THEN ${13:REM fire}
endsnippet

snippet key "Wait for a keypress; two values act like an IF (false, true)" b
${1:10} KEYPRESS ${2:89}, ${3:78}
endsnippet

snippet local "LOCAL / GLOBAL variable scope block" b
${1:10} LOCAL
${2:20}   ${3:REM locally scoped code}
${4:30} GLOBAL
endsnippet

snippet mob "Basic sprite/MOB setup" b
${1:10} MOBCLR
${2:20} MOB ${3:0}, 1, 0, 0, ${4:160}, ${5:100}, 0, 0
${6:30} MOBCOL ${7:7}, ${8:1}, ${9:2}
endsnippet

snippet mobxy "Move the current sprite" b
${1:10} MOBXY ${2:X}, ${3:Y}, ${4:0}, ${5:0}
endsnippet

snippet module "Compile a section out to a reusable module file" b
${1:10} MODULE "${2:SPRITELIB}", ${3:8}, ${4:49152}
${5:20}   ${6:REM module code}
${7:30} MODULE END
endsnippet

snippet on "Computed branch on a variable" b
${1:10} ON ${2:A} ${3:GOTO} ${4:1000}, ${5:2000}, ${6:3000}
endsnippet

snippet openread "Open a sequential file, read from it and close it" b
${1:10} OPEN ${2:2}, ${3:8}, ${4:2}, "${5:DATA},S,R"
${6:20} INPUT# ${2:2}, ${7:A$}
${8:30} IF STATUS THEN ${9:GOTO 100}
${10:40} CLOSE ${2:2}
endsnippet

snippet poke "POKE border and background color" b
${1:10} POKE ${2:53280}, ${3:0}
${4:20} POKE ${5:53281}, ${6:0}
endsnippet

snippet proc "Named subroutine with PASS parameters and a SEND return value" b
${1:100} PROC ${2:MYPROC}
${3:110}   PASS ${4:X}, ${5:Y}
${6:120}   ${7:REM body}
${8:130}   SEND ${9:RESULT}
${10:140} RETURN
endsnippet

snippet reu "Copy memory to and from an REU" b
${1:10} IF DETEXT(${2:0}) = 0 THEN ${3:GOTO 9000}
${4:20} STASH ${5:49152}, ${6:4096}, ${7:0}, ${8:0}
${9:30} FETCH ${6:4096}, ${5:49152}, ${7:0}, ${8:0}
endsnippet

snippet sound "SID voice setup — VOICE must come before FREQ/PULSE/ADSR/WAVE" b
${1:10} SIDCLR
${2:20} VOL ${3:15}
${4:30} VOICE ${5:1}
${6:40} ADSR ${7:0}, ${8:9}, ${9:0}, ${10:0}
${11:50} FREQ ${12:1000}
${13:60} WAVE 1, ${14:2}, 0, 0, 0
endsnippet

snippet sub "Subroutine with RETURN" b
${1:100} REM --- ${2:subroutine name} ---
${3:110}   ${4:REM body}
${5:120} RETURN
endsnippet

snippet trap "Send control to an error handler" b
${1:10} TRAP ${2:9000}, ${3:ERRADDR}

${2:9000} REM --- error handler ---
${4:9010}   PRINT "ERROR AT"; ${3:ERRADDR}
${5:9020} RESUME
endsnippet

snippet vbprog "Vision BASIC program skeleton with a VERSION guard" b
10 REM ${1:program name}
20 VERSION 1.1
30 GLOBAL
40 ${2:REM main code}
50 END
endsnippet
